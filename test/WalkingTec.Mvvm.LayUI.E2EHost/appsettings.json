{
  "Logging": {
    "Console": {
      "IncludeScopes": true,
      "LogLevel": {
        "Default": "Information"
      }
    },
    "WTM": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  },
  "Connections": [
    {
      "Key": "default",
      "Value": "Data Source=e2e-host.db",
      "DbType": "sqlite"
    }
  ],
  "CookiePre": "WTME2E",
  "IsQuickDebug": false,
  "EnableTenant": false,
  "SyncDb": true,
  "EncryptKey": "",
  "PageMode": "Tab",
  "TabMode": "Simple",
  "IsFilePublic": true,
  "ErrorHandler": "/_Framework/Error",
  "Languages": "en",
  "CorsOptions": {
    "EnableAll": false
  },
  "UIOptions": {
    "EncodeHtmlContent": true,
    "DataTable": {
      "RPP": 30,
      "ShowPrint": false,
      "ShowFilter": true
    },
    "ComboBox": {
      "DefaultEnableSearch": false
    },
    "DateTime": {
      "DefaultReadonly": false
    },
    "SearchPanel": {
      "DefaultExpand": true
    }
  },
  "FileUploadOptions": {
    "UploadLimit": 20971520,
    "SaveFileMode": "Database"
  },
  "JwtOptions": {
    "Issuer": "http://localhost",
    "Audience": "http://localhost",
    "Expires": 3600,
    "SecurityKey": "e2e-host-local-only-placeholder-key-do-not-use",
    "RefreshTokenExpires": 86400,
    "LoginPath": "/Login/Login"
  },
  "CookieOptions": {
    "Issuer": "http://localhost",
    "Audience": "http://localhost",
    "Expires": 3600,
    "SlidingExpiration": true,
    "RefreshTokenExpires": 86400,
    "LoginPath": "/Login/Login"
  },
  "E2E": {
    "AdminPassword": "e2e-local-only"
  }
}
