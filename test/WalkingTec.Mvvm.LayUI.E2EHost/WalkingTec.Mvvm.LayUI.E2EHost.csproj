<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Test-only LayUI MVC site used by test/WalkingTec.Mvvm.E2E (Playwright). Never packed or published (#270).
    It is a minimal host: login page, LayUI home frame with menu, and one CRUD module (Gadget) generated by
    the code generator templates in src/WalkingTec.Mvvm.Mvc/GeneratorFiles/Mvc.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WalkingTec.Mvvm.LayUI.E2EHost</AssemblyName>
    <RootNamespace>WalkingTec.Mvvm.LayUI.E2EHost</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1701;1702;1705;1591;0809;1587;1570;NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WalkingTec.Mvvm.Core\WalkingTec.Mvvm.Core.csproj" />
    <ProjectReference Include="..\..\src\WalkingTec.Mvvm.Mvc\WalkingTec.Mvvm.Mvc.csproj" />
    <ProjectReference Include="..\..\src\WalkingTec.Mvvm.TagHelpers.LayUI\WalkingTec.Mvvm.TagHelpers.LayUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Framework UI strings are shared with the demo instead of being copied.
      The manifest names (Resources/Program.*.resx) must match typeof(Program) in this assembly.
    -->
    <EmbeddedResource Include="..\..\demo\WalkingTec.Mvvm.Vue3Demo\Resources\Program.en.resx" Link="Resources\Program.en.resx" />
    <EmbeddedResource Include="..\..\demo\WalkingTec.Mvvm.Vue3Demo\Resources\Program.zh.resx" Link="Resources\Program.zh.resx" />
  </ItemGroup>

</Project>
