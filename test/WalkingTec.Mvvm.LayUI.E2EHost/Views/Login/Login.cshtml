@model WalkingTec.Mvvm.LayUI.E2EHost.ViewModels.HomeVMs.LoginVM

@{
  Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <link rel="stylesheet" href="/layui/css/layui.css">
  <script src="/jquery.min.js"></script>
  <script src="/jquery.cookie.js"></script>
  <script src="/layui/layui.js"></script>
  <script src="/_js/framework_layui.js?time=@DateTime.Now.Ticks"></script>
  <link rel="stylesheet" href="~/sitecss/logincss.css">
  <title>WTM E2E</title>
  <script type="text/javascript">
    layui.use('layer');
  </script>
</head>

<body>
    <div class="loginBody app-login-back-1" style="flex: 1 1 auto !important; ">
      <header class="login-header">
        <img src="/images/logo.png" alt="" height="48">
      </header>
      <div class="login-content">
        <div class="login-form">
          <h1>WTM</h1>
          <form action="/Login/Login" method="post" id="login-form">
            <input type="hidden" name="Redirect" value="@Model.Redirect">
            <ul class="loginForm">
              <li>
                <i><img src="~/images/icon-login04.png" /></i>
                <input type="text" name="ITCode" id="login-account" placeholder="@Model.Localizer["Login.InputUserName"]" class="login-input" autocomplete="off" value="@Model.ITCode">
              </li>
              <li>
                <i style="width: 16px;"><img src="~/images/icon-login01.png" /></i>
                <input type="password" name="Password" id="login-password" placeholder="@Model.Localizer["Login.InputPassword"]" class="login-input">
              </li>
              <li>
                <span class="login-error" id="login-error">@Model.MSD.GetFirstError()</span>
                <button type="submit" id="login-submit" class="login-button" style="cursor:pointer">@Model.Localizer["Login.Login"]</button>
              </li>
            </ul>
          </form>
        </div>
      </div>
  </div>
</body>

</html>
