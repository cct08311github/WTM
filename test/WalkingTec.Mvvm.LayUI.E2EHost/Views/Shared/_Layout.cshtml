<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <title>@ViewData["title"]</title>
  <meta name="renderer" content="webkit">
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
  <meta name="viewport"
    content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=0">
  <link rel="stylesheet" href="/layui/css/layui.css" media="all">
  <link rel="stylesheet" href="/sitecss/wtm.css">
  <link rel="stylesheet" href="/font/iconfont.css">
</head>

<body>
  <div id="LAY_app"></div>
  <script src="/jquery.min.js"></script>
  <script src="/jquery.cookie.js"></script>
  <script src="/layui/layui.js"></script>
  <script src="/layui/xm-select.js"></script>
  <script>
    // The chart refresh in framework_layui.js parses the series with a global JSONfns (the host page provides it, the framework
    // script does not). Same contract as the json-fns helper downstream pages use: strings that start with "function" become functions.
    var JSONfns = {
      parse: function (str) {
        return JSON.parse(str, function (key, value) {
          if (typeof value === 'string' && value.indexOf('function') === 0) { return eval('(' + value + ')'); }
          return value;
        });
      },
      stringify: function (obj) {
        return JSON.stringify(obj, function (key, value) { return typeof value === 'function' ? value.toString() : value; });
      }
    };
  </script>
  <script src="/_js/framework_layui.js?time=@DateTime.Now.Ticks"></script>
  <script>
    var DONOTUSE_IGNOREHASH = false;
    var DONOTUSE_COOKIEPRE = '@ViewData["DONOTUSE_COOKIEPRE"]';
    var DONOTUSE_WINDOWGUID = '@Guid.NewGuid().ToString().Replace("-", "")';
    layui.config({
      base: '/layuiadmin/'
      , version: '@DateTime.Now.Ticks'
    });
  </script>
  @RenderBody()
</body>

</html>
