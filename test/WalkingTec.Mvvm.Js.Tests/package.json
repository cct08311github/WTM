{
  "name": "walkingtec-mvvm-js-tests",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "rootDir": "../..",
    "testEnvironment": "jsdom",
    "coverageProvider": "v8",
    "setupFiles": [
      "<rootDir>/test/WalkingTec.Mvvm.Js.Tests/setup.js"
    ],
    "testMatch": [
      "<rootDir>/test/WalkingTec.Mvvm.Js.Tests/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/WalkingTec.Mvvm.Mvc/framework_layui.js",
      "src/WalkingTec.Mvvm.Mvc/framework_analysis.js"
    ]
  }
}
