<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="coverlet.collector" />
    <!-- AspNetCore.Mvc.Testing version must match the framework version (10.0.4) -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!--
      Issue #372 — pin vulnerable transitive from NPOI.
      NPOI's transitive pull of System.Security.Cryptography.Xml 8.0.2 has HIGH-severity
      CVEs (GHSA-37gx-xxp4-5rgx, GHSA-w3x6-4m5h-cxqf). This direct PackageReference at
      10.0.6 overrides the transitive for this test project.
      .NET 10 will emit NU1510 on this line — that is the expected positive side-effect
      of the override working. DO NOT remove based on NU1510. See Issue #372.
    -->
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\demo\WalkingTec.Mvvm.Demo\WalkingTec.Mvvm.Demo.csproj" />
  </ItemGroup>
</Project>
