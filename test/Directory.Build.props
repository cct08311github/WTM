<Project>
  <!--
    test/Directory.Build.props — applies to all test projects under test/.

    Package versions for test dependencies are now managed by Central Package Management (CPM)
    via Directory.Packages.props at the repo root. The MSBuild version variables that were
    defined here (MoqVersion, FluentAssertionsVersion, MSTestVersion, TestSdkVersion,
    CoverletVersion) have been removed — they are no longer needed since csproj files
    reference packages without Version attributes.

    Version declarations:
      Microsoft.NET.Test.Sdk  17.12.0
      MSTest.TestAdapter       3.6.4
      MSTest.TestFramework     3.6.4
      Moq                      4.20.72
      FluentAssertions         6.12.2
      coverlet.collector       6.0.4
  -->
</Project>
