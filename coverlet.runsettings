<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!-- Output in Cobertura format for ReportGenerator compatibility -->
          <Format>cobertura</Format>

          <!-- Exclude test projects and generated scaffolding from coverage metrics -->
          <Exclude>
            [*.Tests]*,
            [*.Test]*,
            [WalkingTec.Mvvm.Demo]*,
            [WalkingTec.Mvvm.BlazorDemo*]*,
            [WalkingTec.Mvvm.Vue*]*
          </Exclude>

          <!-- Skip auto-generated and explicitly excluded code -->
          <ExcludeByAttribute>
            GeneratedCodeAttribute,
            ExcludeFromCodeCoverageAttribute
          </ExcludeByAttribute>

          <SingleHit>false</SingleHit>
          <IncludeTestAssembly>false</IncludeTestAssembly>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
