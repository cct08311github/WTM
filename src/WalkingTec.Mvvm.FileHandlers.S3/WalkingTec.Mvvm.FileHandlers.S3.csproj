<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WalkingTec.Mvvm.FileHandlers.S3</AssemblyName>
    <Title>$(AssemblyName)</Title>
    <Description>WTM opt-in S3/MinIO file handler — AWSSDK.S3 backed upload/download/delete</Description>
    <IsPackable>true</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Import Project="..\..\common.props" />

  <ItemGroup>
    <!-- AWS SDK S3 client — version managed centrally in Directory.Packages.props -->
    <PackageReference Include="AWSSDK.S3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core provides IWtmFileHandler + IWtmFile; Mvc is NOT required — no HTTP pipeline dependency -->
    <ProjectReference Include="..\WalkingTec.Mvvm.Core\WalkingTec.Mvvm.Core.csproj" />
  </ItemGroup>
</Project>
