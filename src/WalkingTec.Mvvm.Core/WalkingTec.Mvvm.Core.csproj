<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>WalkingTec.Mvvm</Description>
    <AssemblyName>WalkingTec.Mvvm.Core</AssemblyName>
    <Title>$(AssemblyName)</Title>
    <IsPackable>true</IsPackable>
    <Nullable>enable</Nullable>
    <!--
      Issue #934 — the .NET 10 SDK's package-reference pruning silently defeats the
      System.Security.Cryptography.Xml override below at PACK time, not restore time.
      `System.Security.Cryptography.Xml` 10.0.10 matches the SDK's "framework already
      provides this" baseline for net10.0 (that match IS what raises NU1510 on this
      PackageReference), so as of .NET 10, `dotnet pack` marks it PrivateAssets=all /
      IncludeAssets=none and drops it from the shipped .nuspec's <dependencies> —
      confirmed empirically: with pruning enabled, WalkingTec.Mvvm.Core's packed
      nuspec lists NPOI 2.7.6 but NOT System.Security.Cryptography.Xml at all. A
      consumer installing from the registry then gets NPOI's own vulnerable transitive
      pull (8.0.2, GHSA-37gx-xxp4-5rgx / GHSA-w3x6-4m5h-cxqf) with nothing overriding
      it — the override still "works" in THIS repo's own solution-scoped vulnerability
      scan only because the direct PackageReference is still present there; the scan's
      target (the solution) is not what ships (the packed nuspec).
      RestoreEnablePackagePruning=false disables pruning for this project only — every
      other transitively-prunable package (Microsoft.Extensions.* pulled in via EF
      Core, etc.) is unaffected at the consumer side either way, since those were
      never direct PackageReferences here and so never appeared in this nuspec's
      <dependencies> regardless of this setting; this property only changes whether
      THIS project's own direct references get force-excluded from ITS OWN nuspec.
      Tried first and rejected: explicit IncludeAssets="all" PrivateAssets="none" on
      the PackageReference itself (pruning overrides user-set asset metadata
      unconditionally — verified, still pruned); an MSBuild target removing this
      package from the SDK-populated PrunePackageReference item list before
      CollectPrunePackageReferences runs (the removal is visible in a diagnostic
      build log but restore's internal pruning computation still applied the SDK's
      baseline "maximum prunable version" regardless — verified, still pruned).
      Do not remove this property based on a future NU1510 "cleanup" pass; verify
      against the PACKED nuspec (`dotnet pack ... ; unzip -p *.nupkg '*.nuspec'`),
      not `dotnet list package`/NU1510 text, before touching it again.
    -->
    <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
  </PropertyGroup>

  <Import Project="..\..\common.props" />

  <ItemGroup>
    <!-- FrameworkReference provides Microsoft.AspNetCore.Http and other ASP.NET Core APIs
         at the correct .NET 10 version, replacing the old Microsoft.AspNetCore.Http 2.1.34 NuGet package. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="NPOI" />
    <!--
      Issue #816 — pin vulnerable transitive from NPOI.
      NPOI's transitive pull of System.Security.Cryptography.Xml 8.0.2 has HIGH-severity
      CVEs (GHSA-37gx-xxp4-5rgx, GHSA-w3x6-4m5h-cxqf). This direct PackageReference at
      10.0.6 overrides the transitive across the whole solution.
      .NET 10 will emit NU1510 ("framework already provides this package") on this line.
      DO NOT remove based on NU1510 — that signal is the EXPECTED positive side-effect
      of the override working. See commit 7b63587b and Issue #13 post-mortem.
    -->
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="Fare" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!--
      Issue #393 — override vulnerable transitive native SQLite engine.
      EF Core Sqlite pulls SQLitePCLRaw.bundle_e_sqlite3 → lib.e_sqlite3 2.1.11
      (GHSA-2m69-gcr7-jv3q, HIGH). This direct PackageReference promotes the bundle
      to 3.0.3 (lib.e_sqlite3 3.50.3, SQLite 3.50.3) across the whole solution,
      which is outside the advisory's <= 2.1.11 vulnerable range. See Directory.Packages.props.
    -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Oracle.EntityFrameworkCore" />
    <PackageReference Include="MySql.EntityFrameworkCore" />
    <PackageReference Include="Quartz" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WalkingTec.Mvvm.Core.Tests" />
    <InternalsVisibleTo Include="WalkingTec.Mvvm.Core.Test" />
    <InternalsVisibleTo Include="WalkingTec.Mvvm.Benchmarks" />
  </ItemGroup>

</Project>
