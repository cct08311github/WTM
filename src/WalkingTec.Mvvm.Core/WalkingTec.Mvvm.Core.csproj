<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>WalkingTec.Mvvm</Description>
    <AssemblyName>WalkingTec.Mvvm.Core</AssemblyName>
    <Title>$(AssemblyName)</Title>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <Import Project="..\..\common.props" />

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aliyun.OSS.SDK.NetCore" Version="2.14.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="DM.Microsoft.EntityFrameworkCore" Version="9.0.0.43760" />
    <PackageReference Include="Elsa.Server.Core" Version="2.17.0" />
    <PackageReference Include="Fare" Version="2.2.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Oracle.EntityFrameworkCore" Version="10.23.26301" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageReference Include="Quartz" Version="3.22.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- security: pin patched transitive dependency (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7); pulled in by Microsoft.Data.SqlClient / Oracle.ManagedDataAccess.Core. 10.0.x because the Xml pin below requires Pkcs >= 10.0.13 -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- security: pin patched transitive dependency (GHSA-r955-8q5j-3h83, GHSA-w3x6-4m5h-cxqf); pulled in by Elsa.Core -> Microsoft.AspNetCore.DataProtection 9.0.1; 10.0.x because Mvc references DataProtection 10.0.9, which requires Xml >= 10.0.9 -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <!-- security: pin patched transitive dependency (GHSA-2m69-gcr7-jv3q); pulled in by Microsoft.EntityFrameworkCore.Sqlite -> SQLitePCLRaw.bundle_e_sqlite3 -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
  </ItemGroup>

  <!-- net10.0 package pruning treats System.Security.Cryptography.Xml as framework-provided (AspNetCore.App) and drops the pin above from the packed nuspec (and warns NU1510), so consumers without the ASP.NET Core shared framework would still restore the vulnerable 9.0.1 from Elsa. Un-prune this one package so the pin is packed. -->
  <Target Name="KeepSecurityPinsInNuspec" AfterTargets="CollectPrunePackageReferences">
    <ItemGroup>
      <PrunePackageReference Remove="System.Security.Cryptography.Xml" />
    </ItemGroup>
  </Target>

</Project>
