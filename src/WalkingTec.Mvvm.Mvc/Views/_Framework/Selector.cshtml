@model WalkingTec.Mvvm.Core.IBasePagedListVM<WalkingTec.Mvvm.Core.TopBasePoco, WalkingTec.Mvvm.Core.BaseSearcher>
@using WalkingTec.Mvvm.Core.Extensions;
@using WalkingTec.Mvvm.Mvc;
@{
  var tempvar = $"var_{Guid.NewGuid().ToNoSplitString()}";
  var linkscript = "";
  // the values below come from the request (_DONOT_USE_*) through ViewBag; each one is encoded for the place it is written to (SelectorScript)
  var submitFunc = SelectorScript.FunctionReference(ViewBag.SubmitFunc);
}

<script>
    function submitSelect() {
        var res = []
            ,multiSel = @Html.Raw(SelectorScript.Boolean(ViewBag.MultiSel))
            ,displayStrArr = []
            ,hiddenStrArr = [];
        selected = @(tempvar);
        @if (submitFunc != null)
        {
            @Html.Raw(submitFunc)<Text>(selected);</Text>;
        }
      if (selected.length > 0) {
        if (!multiSel && selected.length > 1) {
          layui.layer.msg('@Html.Raw(SelectorScript.JsString(WalkingTec.Mvvm.Core.CoreProgram._localizer?["Sys.SelectOneRowMax"]))');
          return;
        }
        for (var i = 0; i < selected.length; i++) {
          displayStrArr.push(selected[i]['@Html.Raw(SelectorScript.JsString(ViewBag.TextName))']);
          hiddenStrArr.push("<input type='hidden' wtm-tag='wtmselector' name='@Html.Raw(SelectorScript.HtmlAttributeInJsString(ViewBag.FieldName))' value='" + selected[i]['@Html.Raw(SelectorScript.JsString(ViewBag.ValName))'] + "' />");
        }
      }
      else {
          hiddenStrArr.push("<input type='hidden' wtm-tag='wtmselector' name='@Html.Raw(SelectorScript.HtmlAttributeInJsString(ViewBag.FieldName))' value='' />");
      }

        ff.CloseDialog();

        var vals = $('#@Html.Raw(SelectorScript.JsString(ViewBag.SelId))_Container input[type=hidden]');
        for (var i = 0; i < vals.length; i++) {
            vals[i].remove();
        }
        $("#@Html.Raw(SelectorScript.JsString(ViewBag.SelId))_Display").val(displayStrArr.join(","));
        $("#@Html.Raw(SelectorScript.JsString(ViewBag.SelId))_Display").after(hiddenStrArr.join(''));
        @if (ViewBag.TriggerUrl != null)
        {

           linkscript = SelectorScript.TriggerScript(ViewBag.TriggerUrl, ViewBag.ValName, ViewBag.SelId);
          }
      @Html.Raw(linkscript);
    }


    var @(tempvar) = @Html.Raw(SelectorScript.JsonData(ViewBag.SelectData));
    function gridCheckedFunc(obj) {
        var ids = []
            ,gridId = 'wtTable_@Model.UniqueId';
        if (obj.checked === true) {  //选中
            if (obj.type === "all") { // 全选
                var selected = ff.GetSelectionData(gridId);
                for (var i = 0; i < selected.length; i++) {
                    var checked = false;
                    for (var j = 0; j < @(tempvar).length; j++) { // 是否已经选中
                        if (@(tempvar)[j].ID == selected[i].ID) {
                            checked=true;
                            break;
                        }
                    }
                    if(!checked)
                        @(tempvar).push(selected[i]);
                }
            } else {
                if (obj.data.ID === undefined) {
                    obj.data = ff.GetSelectionData(gridId).pop();
                }
                @(tempvar).push(obj.data);
            }
        } else {  //取消选中
            if (obj.type === "all") { // 取消全选
                var nonSelected = ff.GetNonSelectionData(gridId);
                //移除未选中数据
                for (var i = 0; i < nonSelected.length; i++) {
                    @(tempvar).removeByID(nonSelected[i]);
                }
            } else {
                @(tempvar).removeByID(obj.data);
            }
        }
        for (var i = 0; i < @(tempvar).length; i++) {
            ids.push(@(tempvar)[i].ID);
        }
      wtVar_@(Model.UniqueId).config.where.Ids = ids;
    }
</script>

<wt:container style="margin:0px 10px 0px 10px" class='donotuse_pdiv' wtm-name="@ViewBag.FieldName" wtm-linkto="@ViewBag.LinkField" id="Selector_@ViewBag.FieldName">
  <div style="height:10px">&nbsp;</div>
  $$SearchPanel$$
  <wt:grid vm="@Model" hidden-panel="true" checked-func="gridCheckedFunc" url="/_Framework/GetPagingData" need-show-filter="false" need-show-print="false" is-in-selector="true"/>
  <div style="margin-bottom:3px;">
    <wt:row align="AlignEnum.Right">
      <wt:button click="submitSelect();" text="@WalkingTec.Mvvm.Core.CoreProgram._localizer?["Sys.OK"]" size="ButtonSizeEnum.Normal" />
    </wt:row>
  </div>
</wt:container>
