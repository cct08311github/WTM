<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WalkingTec.Mvvm.WorkFlow</AssemblyName>
    <Title>$(AssemblyName)</Title>
    <Description>WTM WorkFlow Module - approval/workflow engine (串签/会签/或签/加签/委托/撤回/回退/条件路由/抄送/超时)</Description>
    <IsPackable>true</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Import Project="..\..\common.props" />

  <ItemGroup>
    <InternalsVisibleTo Include="WalkingTec.Mvvm.WorkFlow.Test" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- No new PackageReference needed for MVP. CPM resolves all versions; NEVER add Version= here. -->

  <ItemGroup>
    <ProjectReference Include="..\WalkingTec.Mvvm.Mvc\WalkingTec.Mvvm.Mvc.csproj" />
  </ItemGroup>

  <!-- WF-21.4: Designer embedded assets.
       Wildcard include prevents the per-file omission that caused the #238/#297 latent 404.
       All files under designer\ become embedded resources; resource names follow the
       EmbeddedFileProvider convention: dots replace directory separators in the manifest name
       (e.g. designer\designer.html → WalkingTec.Mvvm.WorkFlow.designer.designer.html).
       T-DSN-16 asserts manifest presence + TestServer 200 for every referenced URL. -->
  <ItemGroup>
    <EmbeddedResource Include="designer\**" />
  </ItemGroup>
</Project>
