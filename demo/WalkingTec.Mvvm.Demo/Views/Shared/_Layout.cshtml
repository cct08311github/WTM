@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
  // Issue #573 default flip: layui-next (2.13.8) is now the default. Config
  // key "Layui:Asset" == "legacy" (exact match only) pins back to the
  // vendored 2.6.3 tree at /layui; any other value (including the former
  // opt-in value "next") or absent config selects /layui-next. The raw
  // config value is NEVER concatenated into the URL — it only selects
  // between these two fixed string literals.
  var layuiBase = string.Equals(Configuration["Layui:Asset"], "legacy", StringComparison.Ordinal) ? "/layui" : "/layui-next";
  // Issue #681: e2e-only opt-in for the #627 legacy-script-rehydration kill-switch
  // (docs/csp-hardening.md). Gated on the WTM_E2E_KILLSWITCH env var, which the
  // e2e-test.yml workflow's "killswitch" matrix leg sets to "1" for the demo
  // process it starts (IConfiguration's environment-variables provider surfaces a
  // flat env var name as a top-level config key with no extra wiring needed).
  // Absent (the default, including every non-e2e run and the baseline matrix leg)
  // == exact-match miss == meta tag never emitted == byte-identical default
  // behaviour, per docs/csp-hardening.md's "Default is OFF" contract.
  var e2eKillSwitchEnabled = string.Equals(Configuration["WTM_E2E_KILLSWITCH"], "1", StringComparison.Ordinal);
}
<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <title>@ViewData["title"]</title>
  <meta name="renderer" content="webkit">
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
  <meta name="viewport"
    content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=0">
  @if (e2eKillSwitchEnabled)
  {
    @* Issue #681/#627: enables ff.DisableLegacyScriptRehydration for the e2e
       "killswitch" matrix leg only — see docs/csp-hardening.md § "The kill-switch". *@
    <meta name="wtm-disable-legacy-script-rehydration" content="true">
  }
  <link rel="stylesheet" href="@(layuiBase)/css/layui.css" media="all">
  @if (layuiBase == "/layui-next")
  {
    @* Issue #573: layedit was removed from layui upstream in 2.8, so
       layui-next (2.13.8) ships no CSS for it; this vendors the 2.6.3
       layedit rules so wt:richtextbox stays styled on the next tree. *@
    <link rel="stylesheet" href="/layui-next/css/layedit.css" media="all">
  }
  <link rel="stylesheet" href="/sitecss/wtm.css">
  <link rel="stylesheet" href="/font/iconfont.css">
  <link rel="shortcut icon" href="/favicon.ico" />
</head>

<body>
  <div id="LAY_app"></div>
  <script src="/jquery.min.js"></script>
  <script src="/jquery.cookie.js"></script>
  <script src="/echarts/json-fns.js"></script>
  <script src="@(layuiBase)/layui.js"></script>
  <script src="@(layuiBase)/xm-select.js"></script>
  <script src="/echarts/echarts.min.js"></script>
  <script src="/echarts/chalk.js"></script>
  <script src="/echarts/essos.js"></script>
  <script src="/echarts/macarons.js"></script>
  <script src="/echarts/roma.js"></script>
  <script src="/echarts/vintage.js"></script>
  <script src="/echarts/walden.js"></script>
  <script src="/echarts/westeros.js"></script>
  <script src="/echarts/wonderland.js"></script>
  @* Issue #789 Phase 3B: DOMPurify must load BEFORE framework_layui.js so ff.SafeHtml works. *@
  <script src="/_js/dompurify.js?time=@DateTime.Now.Ticks"></script>
  <script src="/_js/framework_layui.js?time=@DateTime.Now.Ticks"></script>
  <script>
    var DONOTUSE_IGNOREHASH = false;
    var DONOTUSE_COOKIEPRE = '@ViewData["DONOTUSE_COOKIEPRE"]';
    var DONOTUSE_WINDOWGUID = '@Guid.NewGuid().ToString().Replace("-", "")';
    layui.config({
      base: '/layuiadmin/'
      , version: '@DateTime.Now.Ticks'
    });
    @* Issue #573: layedit was removed from layui upstream in 2.8, so
       layui-next (2.13.8) has no builtin layedit module for wt:richtextbox's
       layui.use('layedit', ...) call (see RichTextBox.cs) to lazy-load. The
       extend below points module resolution at the vendored 2.6.3 layedit.js
       beside the next tree, right after layui.config() and before any page
       body renders. On the legacy /layui tree the line is omitted and layedit
       keeps lazy-loading as a 2.6.3 builtin. *@
    @if (layuiBase == "/layui-next")
    {
      @:layui.extend({ layedit: '{/}/layui-next/layedit' });
    }
  </script>
  @RenderBody()
</body>

</html>
