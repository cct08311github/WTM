@model WalkingTec.Mvvm.Demo.ViewModels.ECommerceVMs.OrderListVM
@inject IStringLocalizer<Program> Localizer;

<wt:searchpanel vm="@Model" reset-btn="true">
<wt:row items-per-row="ItemsPerRowEnum.Three">
    <wt:combobox field="Searcher.Status" empty-text="全部" />
    <wt:combobox field="Searcher.PaymentMethod" empty-text="全部" />
    <wt:datetime field="Searcher.OrderDateFrom" />
    <wt:datetime field="Searcher.OrderDateTo" />
</wt:row>
</wt:searchpanel>
<wt:grid vm="@Model" url="/Order/Search" enable-analysis="true"/>
