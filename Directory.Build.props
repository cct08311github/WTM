<Project>
  <!--
    Root Directory.Build.props — applies to all projects in the solution.

    Package version management has migrated to Central Package Management (CPM).
    All package versions are declared in Directory.Packages.props at the repo root.
    Individual .csproj files use bare <PackageReference Include="X" /> without Version.

    Transitive overrides that previously lived here as <PackageReference Include="..." Version="...">
    (Common.Logging, Microsoft.EntityFrameworkCore.Relational, Microsoft.EntityFrameworkCore.Sqlite)
    are now declared as <PackageVersion> entries in Directory.Packages.props.
    CPM applies these version pins solution-wide without needing explicit references in every project.

    See dependency-management.md § NU1510 for the security-pin policy
    (System.Security.Cryptography.Xml, Common.Logging).
  -->
</Project>
