<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    Central Package Management (CPM) — single source of truth for all NuGet versions.

    Why CPM instead of MSBuild variable expansion via common.props:
    On newer .NET 10 SDKs (GitHub-hosted ubuntu), <PackageReference> items are evaluated
    BEFORE <Import> runs, so $(NPOIVersion) / $(EntityFrameworkCoreVersion) etc. expand
    to empty strings, causing NU1015 errors or silent fallback to oldest version.
    CPM evaluation is order-independent and SDK-patch-independent.

    Version groups:
      - Microsoft .NET 10 runtime packages: 10.0.9 (GA cadence, Issue #660)
      - Blazor WebAssembly SDK packages: 10.0.9 (aligned with runtime GA, Issue #660)
      - Third-party: pinned to latest stable as of 2026-05, routine patches per Issue #660
      - DB providers: independent cadence, pinned explicitly
      - Test packages: aligned with test/Directory.Build.props

    Security overrides:
      System.Security.Cryptography.Xml — direct pin at 10.0.10 to override
      NPOI's transitive pull of 8.0.2 (GHSA-37gx-xxp4-5rgx, GHSA-w3x6-4m5h-cxqf),
      kept >= the Microsoft runtime/EF Core group above.
      Bumped 10.0.9 -> 10.0.10 for Issue #788: five advisories
      (GHSA-23rf-6693-g89p, GHSA-8q5v-6pqq-x66h, GHSA-cvvh-rhrc-wg4q,
      GHSA-g8r8-53c2-pm3f, GHSA-mmjf-rqrv-855v) were published against 10.0.9
      itself after v10.17.0 shipped clean; 10.0.10 is the patched servicing build.
      NU1510 on this entry is EXPECTED (override working). See Issue #13
      (originally introduced as #816/#817 on this repo's pre-internal infrastructure-cutover GitHub
      tracker, now defunct).

    Common.Logging — transitive from NPOI; pinned to 3.4.1 (.NET Standard 2.0)
    to avoid malformed TFM in 1.2.0 that newer NuGet rejects with NU1202.
  -->

  <ItemGroup>
    <!-- ===== Microsoft ASP.NET Core / EF Core (10.0.9) ===== -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.SpaServices.Extensions" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <!-- Microsoft.Extensions.TimeProvider.Testing has no 10.0.x patch beyond 10.0.0 as of 2026-07
         (next published version is 10.1.0, a minor bump outside the 10.0.x line) -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />

    <!-- ===== DB Providers (independent cadence) ===== -->
    <PackageVersion Include="MySql.EntityFrameworkCore" Version="10.0.1" />
    <PackageVersion Include="MySqlConnector" Version="2.4.0" />
    <!-- Npgsql: pinned to exactly what Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 requires transitively -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Oracle.EntityFrameworkCore" Version="10.23.26100" />

    <!-- ===== Third-party framework packages ===== -->
    <PackageVersion Include="Asp.Versioning.Mvc" Version="8.1.1" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.1" />
    <PackageVersion Include="BCrypt.Net-Next" Version="4.1.0" />
    <PackageVersion Include="DUWENINK.Captcha" Version="0.8.0" />
    <PackageVersion Include="Fare" Version="2.2.1" />
    <PackageVersion Include="NPOI" Version="2.7.6" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="Quartz" Version="3.16.1" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageVersion Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
    <PackageVersion Include="Swashbuckle.AspNetCore.Swagger" Version="10.1.5" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.1.5" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.1.5" />
    <!--
      Issue #528 — pin vulnerable transitive from Swashbuckle.AspNetCore 10.1.5.
      Swashbuckle 10.1.5 transitively pulls Microsoft.OpenApi 2.4.1, which carries
      HIGH-severity GHSA-v5pm-xwqc-g5wc (circular schema references terminate OpenAPI
      parsing). Advisory affects >= 2.0.0-preview11, <= 2.7.4; first patched 2.7.5.
      2.7.5 stays on the 2.x major line, so it is API-compatible with Swashbuckle 10.1.5.
      Wired via a direct PackageReference in Mvc.csproj to override the transitive
      solution-wide. NU1510 on that line is EXPECTED (override working) — DO NOT remove.
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageVersion Include="VueCliMiddleware" Version="6.0.0" />

    <!-- ===== Security overrides (transitive pins) ===== -->
    <!--
      Issue #13: NPOI transitively pulls System.Security.Cryptography.Xml 8.0.2
      which has HIGH CVEs. Pinned to 10.0.9 to stay >= the Microsoft ASP.NET Core / EF
      Core group above (Issue #660). NU1510 here is EXPECTED = override working.
      (Originally introduced as #816/#817 on this repo's pre-internal infrastructure-cutover GitHub
      tracker, now defunct; #13 is the local post-mortem issue — see
      dependency-management.md § "Known Scenario B".)
      See dependency-management.md § NU1510 section before removing this.
    -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.10" />
    <!--
      NPOI 1.2.3 (legacy compat shim) transitively pulls Common.Logging 1.2.0 which has
      a malformed TFM that newer NuGet rejects with NU1202. Pinned to 3.4.1 (netstandard2.0).
    -->
    <PackageVersion Include="Common.Logging" Version="3.4.1" />
    <PackageVersion Include="Common.Logging.Core" Version="3.4.1" />
    <!--
      Issue #393: EF Core Sqlite 10.0.4 transitively pulls SQLitePCLRaw.bundle_e_sqlite3
      whose native SQLitePCLRaw.lib.e_sqlite3 resolved to 2.1.11 — flagged NU1903
      (GHSA-2m69-gcr7-jv3q, HIGH: bundled SQLite engine, vulnerable range <= 2.1.11).
      No override existed until SQLitePCLRaw shipped the 3.0.x line: bundle 3.0.3 pulls
      lib.e_sqlite3 3.50.3 (SQLite 3.50.3), which is OUTSIDE the advisory's <= 2.1.11
      range, clearing the NU1903. Wired via a direct PackageReference in Core.csproj.
    -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />

    <!-- ===== Blazor UI component packages ===== -->
    <PackageVersion Include="BootstrapBlazor" Version="8.7.2" />
    <PackageVersion Include="BootstrapBlazor.Chart" Version="8.1.5" />
    <PackageVersion Include="BootstrapBlazor.SummerNote" Version="8.0.3" />

    <!-- ===== Packaging / SourceLink (Issue #678) ===== -->
    <!--
      Origin is a self-hosted internal infrastructure instance, so the internal infrastructure-specific SourceLink
      provider is required (GitHub/GitLab providers URL-map differently and
      would embed the wrong source-server URLs in the PDB). Pinned to the
      latest stable (non-preview) release as of 2026-07 alongside the other
      Microsoft SourceLink/Build.Tasks.Git packages' shared release cadence.
    -->
    <PackageVersion Include="Microsoft.SourceLink.Gitea" Version="10.0.301" />

    <!-- ===== Test packages ===== -->
    <!--
      Issue #965 — pure-.NET ECMAScript parser used ONLY to assert that
      DataTableTagHelper's emitted GridAction toolbar-action script is valid
      JavaScript (Test262-complete, no interpreter/execution, no external
      process/node dependency — see DataTableTagHelperUnwrappedIife965Tests).
      Not referenced by any shipping (non-test) project.
    -->
    <PackageVersion Include="Acornima" Version="1.6.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.14.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="FluentAssertions" Version="6.12.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="Microsoft.TypeScript.MSBuild" Version="5.4.2" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="MSTest.TestAdapter" Version="3.6.4" />
    <PackageVersion Include="MSTest.TestFramework" Version="3.6.4" />
  </ItemGroup>

</Project>
